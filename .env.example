# OpenAI is used first when this key is configured.
OPENAI_API_KEY=your-openai-api-key
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_CHAT_MODEL=your-chat-model

# Local fallback model. It is downloaded by sentence-transformers on first use.
HF_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# API authentication. Use a long random value for JWT_SECRET_KEY.
AUTH_USERNAME=admin
AUTH_PASSWORD=change-this-password
JWT_SECRET_KEY=change-this-to-a-long-random-secret
JWT_EXPIRE_MINUTES=60